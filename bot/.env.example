# RPC Configuration
RPC_URL=https://rpc.hyperliquid.xyz/evm
# Alternative: RPC=https://rpc.hyperliquid.xyz/evm (both are supported)

# Wallet Configuration
PRIVATE_KEY=0x...

# Contract Configuration
CONTRACT_ADDRESS=0x...

# Profit Configuration
PROFIT_RECEIVER=0x...

# Liquidation Parameters
MAX_REPAY_USDC=2000000
# Maximum USDC to repay per liquidation (in 6 decimals, e.g. 2000000 = 2000 USDC)

SLIPPAGE_BPS=50
# Slippage tolerance in basis points (50 = 0.5%)

# Telegram Notifications (optional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Bot Control
BOT_PAUSED=false
# Set to 'true' to pause the bot
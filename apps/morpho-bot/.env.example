# Morpho Bot Environment Configuration - Milestone 2

# ===== CHAIN CONFIGURATION =====
# Chain ID for HyperEVM
CHAIN_ID=999

# RPC endpoint for HyperEVM
RPC_URL_999=https://rpc.hyperliquid.xyz/evm

# ===== API ENDPOINTS =====
# Morpho API (GraphQL) - CORRECT URL
MORPHO_API_URL=https://api.morpho.org

# LiquidSwap API for swap routing
LIQUIDSWAP_API_URL=https://api.liqd.ag

# Ponder indexer (optional - not used in Milestone 2)
PONDER_SERVICE_URL=http://localhost:42069

# ===== CANDIDATE DISCOVERY =====
# Maximum candidates to fetch from API
MAX_CANDIDATES=500

# Maximum simulations to run per execution
# Uses multicall batching for efficiency
MAX_SIMULATIONS=100

# Maximum positions to print in output
MAX_POSITIONS_PRINT=50

# ===== EXECUTION MODE =====
# Simulation only mode (1 = no transactions, 0 = send transactions)
# Keep at 1 for Milestone 2
SIMULATION_ONLY=1

# ===== PROFIT GATING =====
# Enable profit checking (0 = disabled, 1 = enabled)
PROFIT_CHECK_ENABLED=0

# Minimum profit in USD to execute (only used if PROFIT_CHECK_ENABLED=1)
MIN_PROFIT_USD=5.0

# ===== TEST MODE =====
# Enable test mode to find at-risk positions (0 = disabled, 1 = enabled)
# In test mode, LLTV is artificially lowered to find positions that are close to liquidation
TEST_MODE=0

# LLTV multiplier for test mode (e.g., 0.80 = use 80% of actual LLTV)
# Lower values will find more at-risk positions
# Example: If market LLTV is 90%, test mode with 0.80 will check if position
#          would be liquidatable at 72% LLTV (90% * 0.80)
TEST_LLTV_MULTIPLIER=0.80

# ===== WALLET CONFIGURATION (Milestone 3+) =====
# Private key for transaction sending (not used in Milestone 2)
# PRIVATE_KEY=0x...

# Executor contract address (not deployed yet - Milestone 3)
# EXECUTOR_ADDRESS=0x...

# ============================================
# EREBUS Morpho Bot - Environment Configuration
# ============================================
# Copy to .env.morpho and fill in secrets
# NEVER commit .env.morpho to git
# chmod 600 .env.morpho for security

# ============================================
# Chain Configuration
# ============================================
RPC_URL_999=https://rpc.hyperliquid.xyz/evm
CHAIN_ID=999

# ============================================
# Execution Mode
# ============================================
# 0 = dry-run (simulation only), 1 = live execution
EXECUTION_ENABLED=0

# Execution mode: 'flashloan' or 'prefund'
EXECUTION_MODE=flashloan

# ============================================
# Executor Contracts
# ============================================
# V1 Flashloan executor (loan token profits)
FLASHLOAN_EXECUTOR_ADDRESS_999=0x98FCe9e656DBc832B2e2392a3fE188f7518CC234

# V2 Flashloan executor (HYPE profits with gas-aware profit check)
FLASHLOAN_EXECUTOR_V2_ADDRESS_999=0x51C6d213a8A9103ad795596EB28070F7ff525B4e
USE_EXECUTOR_V2=1

# For prefund mode (optional):
# PREFUND_EXECUTOR_ADDRESS_999=0x...

# ============================================
# Wallet & Treasury
# ============================================
# Private key for signing transactions (NO 0x prefix)
LIQUIDATION_PRIVATE_KEY_999=

# Treasury address to receive profits
TREASURY_ADDRESS=0xdA042130f265e594e3f8aF12E006F63BAD2349d3

# ============================================
# Telegram Notifications
# ============================================
TELEGRAM_ENABLED=1
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=1286009814
# TELEGRAM_SEND_ON_SENT=0
# TELEGRAM_RATE_LIMIT_SECONDS=30
# TELEGRAM_MAX_PER_HOUR=60

# ============================================
# Scheduler Configuration
# ============================================
TICK_BASE_SECONDS=30
TICK_FAST_SECONDS=10
JITTER_PCT=10
FAST_MODE_MINUTES=5

# ============================================
# Health Server
# ============================================
HEALTH_PORT=4001

# ============================================
# Safety Controls
# ============================================
BOT_PAUSED=false
SLIPPAGE_BPS=50
MAX_PRICE_IMPACT_PCT=10
# SEIZE_BUFFER_BPS=5

# ============================================
# Per-tick Limits
# ============================================
CANDIDATES_PER_TICK=400
MAX_CONFIRMATIONS_PER_TICK=200
MAX_SIMULATIONS_PER_TICK=75
MAX_TX_PER_TICK=2

# ============================================
# Cooldowns (minutes)
# ============================================
SOLVENT_COOLDOWN_MINUTES=30
FAIL_COOLDOWN_MINUTES=60
EXEC_FAIL_COOLDOWN_MINUTES=120

# ============================================
# Cache TTLs
# ============================================
VAULTS_TTL_MINUTES=30
MARKETS_TTL_MINUTES=15
# CANDIDATES_TTL_SECONDS=20

# ============================================
# Flashloan Configuration
# ============================================
# Buffer: 100% (10000 bps) to handle interest accrual and rounding
FLASHLOAN_BUFFER_BPS=10000
# MIN_FLASHLOAN_PROFIT=0
# MAX_FLASHLOAN_ASSETS=

# ============================================
# Project X Swap Configuration (V2 profit swap)
# ============================================
PRJX_ROUTER_ADDRESS=0x1EbDFC75FfE3ba3de61E7138a3E8706aC841Af9B
PRJX_QUOTER_ADDRESS=0x51f82BCf0785EB8E2297e02F36AB38aca23eb0c6
PROFIT_SLIPPAGE_BPS=100

# ============================================
# Dust Filter (optional, simulation already filters for profitability)
# ============================================
# MIN_REPAY_ASSETS=1000000

# ============================================
# Testing Mode (set to 0/false for production)
# ============================================
# Accept unprofitable trades (for testing full flow)
ALLOW_UNPROFITABLE=0

# Artificially lower LLTV to find at-risk positions
# TEST_MODE=0
# TEST_LLTV_MULTIPLIER=0.80

# ============================================
# Logging
# ============================================
# 'pretty' for human-readable, 'jsonl' for structured logs
LOG_FORMAT=pretty

# ============================================
# Run Mode
# ============================================
# Run once then exit (for testing)
# RUN_ONCE=0

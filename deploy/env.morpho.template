# ============================================
# EREBUS Morpho Bot - Environment Configuration
# ============================================
# Copy to .env.morpho and fill in secrets
# NEVER commit .env.morpho to git
# chmod 600 .env.morpho for security

# ============================================
# Chain Configuration
# ============================================
RPC_URL_999=https://rpc.hyperliquid.xyz/evm
CHAIN_ID=999

# ============================================
# Execution Mode
# ============================================
# 0 = dry-run (simulation only), 1 = live execution
EXECUTION_ENABLED=0

# Execution mode: 'flashloan' or 'prefund'
EXECUTION_MODE=flashloan

# ============================================
# Executor Contracts (fill based on mode)
# ============================================
# For flashloan mode:
FLASHLOAN_EXECUTOR_ADDRESS_999=0x...

# For prefund mode (optional):
# PREFUND_EXECUTOR_ADDRESS_999=0x...

# ============================================
# Wallet & Treasury
# ============================================
# Private key for signing transactions (NO 0x prefix)
LIQUIDATION_PRIVATE_KEY_999=

# Treasury address to receive profits
TREASURY_ADDRESS=0xdA042130f265e594e3f8aF12E006F63BAD2349d3

# ============================================
# Telegram Notifications
# ============================================
TELEGRAM_ENABLED=1
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=1286009814

# ============================================
# Scheduler Configuration
# ============================================
TICK_BASE_SECONDS=30
TICK_FAST_SECONDS=10
JITTER_PCT=10
FAST_MODE_MINUTES=5

# ============================================
# Health Server
# ============================================
HEALTH_PORT=4001

# ============================================
# Safety Controls
# ============================================
BOT_PAUSED=false
SLIPPAGE_BPS=50
MAX_PRICE_IMPACT_PCT=10

# ============================================
# Per-tick Limits
# ============================================
CANDIDATES_PER_TICK=400
MAX_CONFIRMATIONS_PER_TICK=200
MAX_SIMULATIONS_PER_TICK=75
MAX_TX_PER_TICK=2

# ============================================
# Cooldowns (minutes)
# ============================================
SOLVENT_COOLDOWN_MINUTES=30
FAIL_COOLDOWN_MINUTES=60
EXEC_FAIL_COOLDOWN_MINUTES=120

# ============================================
# Cache TTLs
# ============================================
VAULTS_TTL_MINUTES=30
MARKETS_TTL_MINUTES=15

# ============================================
# Flashloan Configuration
# ============================================
FLASHLOAN_BUFFER_BPS=10000
# MIN_FLASHLOAN_PROFIT=0
# MAX_FLASHLOAN_ASSETS=

# ============================================
# Dust Filter
# ============================================
MIN_REPAY_ASSETS=1000000
